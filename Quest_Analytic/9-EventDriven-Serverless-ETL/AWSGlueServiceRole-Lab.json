{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Effect": "Allow",
            "Action": [
                "glue:*",
                "s3:GetBucketLocation",
                "s3:ListBucket",
                "s3:ListAllMyBuckets",
                "s3:GetBucketAcl",
                "ec2:DescribeVpcEndpoints",
                "ec2:DescribeRouteTables",
                "ec2:CreateNetworkInterface",
                "ec2:DeleteNetworkInterface",
                "ec2:DescribeNetworkInterfaces",
                "ec2:DescribeSecurityGroups",
                "ec2:DescribeSubnets",
                "ec2:DescribeVpcAttribute",
                "iam:ListRolePolicies",
                "iam:GetRole",
                "iam:GetRolePolicy",
                "cloudwatch:PutMetricData"
            ],
            "Resource": [
                "*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:CreateBucket"
            ],
            "Resource": [
                "arn:aws:s3:::aws-glue-*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject"
            ],
            "Resource": [
                "arn:aws:s3:::aws-glue-*/*",
                "arn:aws:s3:::*/*aws-glue-*/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "s3:GetObject"
            ],
            "Resource": [
                "arn:aws:s3:::crawler-public*",
                "arn:aws:s3:::aws-glue-*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "logs:CreateLogGroup",
                "logs:CreateLogStream",
                "logs:PutLogEvents"
            ],
            "Resource": [
                "arn:aws:logs:*:*:*:/aws-glue/*"
            ]
        },
        {
            "Effect": "Allow",
            "Action": [
                "ec2:CreateTags",
                "ec2:DeleteTags"
            ],
            "Condition": {
                "ForAllValues:StringEquals": {
                    "aws:TagKeys": [
                        "aws-glue-service-resource"
                    ]
                }
            },
            "Resource": [
                "arn:aws:ec2:*:*:network-interface/*",
                "arn:aws:ec2:*:*:security-group/*",
                "arn:aws:ec2:*:*:instance/*"
            ]
        }
 {
            "Action": [
                "ec2:Describe*",
                "redshift-data:*",
                "redshift-serverless:*",
                "redshift:*",
                "s3:*",
                "secretsmanager:*"
            ],
            "Resource": "*",
            "Effect": "Allow"
        },
        {
            "Condition": {
                "StringLike": {
                    "iam:PassedToService": [
                        "glue.amazonaws.com"
                    ]
                }
            },
            "Action": "iam:PassRole",
            "Resource": "arn:aws:iam::*:role/AWSGlueServiceRole-Lab",
            "Effect": "Allow"
        },
        {
            "Action": "*",
            "Resource": [
                "arn:aws:lambda:us-east-1:186526355503:function:gbl_lab_monitoring",
                "arn:aws:iam::186526355503:role/LabStack-c1a3e936-0ffc-40-GblLabMonitoringgbllabmon-RWP9moAFxMZG",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-dtWcRifTxU50",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-ZyR4jK6mxwyH",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-nLtE1eGWIHCs",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-WTk6zp6kTGl7",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-x2bTSUjcQsrM",
                "arn:aws:events:us-east-1:186526355503:rule/LabStack-c1a3e936-0ffc-40-GblLabMonitoringmonitorin-MIMWJBz2j5ns"
            ],
            "Effect": "Deny"
        },
        {
            "Action": "lambda:PutProvisionedConcurrencyConfig",
            "Resource": "*",
            "Effect": "Deny"
        }        
    ]
}